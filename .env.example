# Rename to `.env.local` and fill in real values from your Okta admin console.
# All regular users MUST authenticate via Okta SSO.
# Only the local emergency admin can bypass Okta (via the hidden form on the login page).
#
# ── IMPORTANT: Okta does NOT accept "localhost" as a redirect URI in production.
#    Register your machine's actual hostname in Okta instead.
#    Vite is configured with host:true so the app is reachable by hostname.
#
#    Find your hostname:   hostname          (Windows/Linux)
#    Examples:
#      http://lp3-ap-51737321.prod.hclpnp.com:5173/login/callback
#      http://lp3-ap-51737321:5173/login/callback
#
# Okta admin → Applications → your app → General Settings
#   Grant type            = Authorization Code + PKCE
#   Sign-in redirect URI  = http://<YOUR-HOSTNAME>:5173/login/callback
#   Sign-out redirect URI = http://<YOUR-HOSTNAME>:5173/login
#   Initiate login URI    = http://<YOUR-HOSTNAME>:5173/login
#   Assignments           = the group(s) allowed to use HCL Learning Hub
#
# Leave VITE_OKTA_REDIRECT_URI and VITE_OKTA_POST_LOGOUT_REDIRECT_URI BLANK below.
# The app auto-detects the correct URL from window.location.origin at runtime,
# so it works on any hostname without rebuilding.
#
# Role assignment via Okta Groups claim (configure in Okta authorization server):
#   Groups containing "admin"   → ADMIN role
#   Groups containing "manager" → MANAGER role
#   All others                  → USER (Learner) role  ← default for new users

# ── Backend API ───────────────────────────────────────────────────────────────
# Use your hostname here too so the browser can reach the API server.
VITE_API_URL=http://localhost:4000

# ── Okta OIDC ────────────────────────────────────────────────────────────────
VITE_OKTA_ISSUER=https://hcl-software.oktapreview.com
VITE_OKTA_CLIENT_ID=0oa13io7fhtx5FBLw1d8
# Leave these blank — redirect URI is auto-detected from window.location.origin
VITE_OKTA_REDIRECT_URI=
VITE_OKTA_POST_LOGOUT_REDIRECT_URI=

# Optional: extra scopes beyond openid/profile/email.
# Add "groups" if your Okta authorization server has a Groups claim configured.
VITE_OKTA_SCOPES=openid profile email

# Optional: name of the ID token claim that carries the learner's manager email.
# Ask your Okta admin to add this claim (usually mapped from user.manager).
# Leave empty to disable auto-fill and rely on the manual input field instead.
VITE_OKTA_MANAGER_CLAIM=manager

# Optional: name of the ID token claim that carries the learner's manager id.
# Common values are managerId, manager_id, or managerEmployeeId depending on your IdP mapping.
VITE_OKTA_MANAGER_ID_CLAIM=managerId
