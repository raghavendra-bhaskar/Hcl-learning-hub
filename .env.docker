# HCL Learning Hub — Production Environment
# Copy to .env and fill in real values before running: docker compose up -d --build
#
# Generate secrets with:
#   openssl rand -hex 32     ← for DB_PASSWORD and JWT_SECRET

# ── Database ──────────────────────────────────────────────────────────────────
DB_PASSWORD=change-me-strong-db-password

# ── Application ───────────────────────────────────────────────────────────────
# Public URL where the app is reachable (used for CORS). No trailing slash.
# Examples:
#   http://192.168.1.100        (IP address)
#   http://lp3-ap-51737321      (short hostname)
#   https://learning.hcl.com    (domain with HTTPS via reverse proxy)
FRONTEND_ORIGIN=http://YOUR-SERVER-IP

# Port nginx listens on (80 for standard HTTP)
HTTP_PORT=80

# ── Local Admin Account ───────────────────────────────────────────────────────
# Emergency fallback login when Okta is unavailable.
# Login URL: http://YOUR-SERVER-IP/login  → click "Admin" link
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@HCL2026!

# 32+ character random string for signing session JWTs — keep secret!
JWT_SECRET=change-me-to-a-64-char-random-hex-string-here

# ── Okta SSO (configured post-install via Admin UI) ───────────────────────────
# You do NOT need to set Okta values here. After first login as admin,
# go to Admin → Authentication Realm and configure Okta there — settings
# are saved in the Docker volume and survive restarts.
