# Copy to `.env` and fill in real values.

# ── Database ─────────────────────────────────────────────────────────────
DATABASE_URL="postgresql://hcl_hub:hcl_hub_dev@localhost:5432/hcl_learning_hub"

# ── Server ───────────────────────────────────────────────────────────────
PORT=4000
NODE_ENV=development
# Set this to the hostname URL the browser uses to access the frontend.
# Okta does not allow localhost in production, so use the machine hostname.
# e.g. http://lp3-ap-51737321.prod.hclpnp.com:5173
#      http://lp3-ap-51737321:5173
FRONTEND_ORIGIN=http://<YOUR-HOSTNAME>:5173

# ── Okta OIDC (same tenant as the frontend) ─────────────────────────────
# Leave blank to disable Okta JWT verification and rely only on local admin.
OKTA_ISSUER=
OKTA_AUDIENCE=api://default
OKTA_CLIENT_ID=

# ID-token claim names for manager (must match frontend + Okta admin config)
OKTA_MANAGER_CLAIM=manager
OKTA_MANAGER_ID_CLAIM=managerId

# ── Local admin fallback (prototype only) ───────────────────────────────
# Disable in production by setting ENABLE_LOCAL_ADMIN=false.
ENABLE_LOCAL_ADMIN=true
LOCAL_ADMIN_USERNAME=admin
LOCAL_ADMIN_PASSWORD=admin

# 32+ char random string used to sign local admin session JWTs.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
LOCAL_ADMIN_JWT_SECRET=change-me-to-a-long-random-hex-string
