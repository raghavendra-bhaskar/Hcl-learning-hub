node_modules/
dist/
.env.local
.env.*.local

# TLS certificates — never commit private keys or passphrases
certs/

# Server runtime data — contains oidc-config.json (Okta secrets), uploaded avatars, etc.
server/data/

# Environment files — contain DB credentials and JWT secrets (templates are OK to commit)
server/.env
.env

# Large binary / media files — do not bloat the repository
*.mp4
*.mov
*.avi
*.mkv
*.pdf
*.zip
*.tar.gz

# Offline bundle build output — regenerate with packaging/build-bundle.*
dist-bundle/
# Docker Desktop installer staged for packaging/build-bundle.ps1 -WithDocker
packaging/payload/*
!packaging/payload/README.txt
# Generated at install time — contains DB password, JWT secret, admin password
.deploy-credentials

# Source deployment runtime state (deploy/*.sh)
deploy/hub.env
.hub-token
logs/
run/
backups/
restore-*.log
server/.env.bak.*

# OS
.DS_Store
Thumbs.db
