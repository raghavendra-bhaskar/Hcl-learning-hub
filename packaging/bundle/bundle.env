# ============================================================
# HCL Software Learning Hub — Offline Bundle Configuration
#
# Shared by every installer / start / stop script on Linux and
# Windows. Edit BEFORE building the bundle; the file is copied
# into the bundle as-is and read at install time.
#
# Format is intentionally restricted to KEY=VALUE with no
# quoting, no substitution and no spaces so that both Bash and
# PowerShell can parse it with a one-line regex.
# ============================================================

APP_NAME=hcl-learning-hub
APP_VERSION=1.0.0

# Container / stack naming
STACK_NETWORK=hcl-learning-hub
API_CONTAINER=hcl-api
WEB_CONTAINER=hcl-web
DB_CONTAINER=hcl-postgres
DB_VOLUME=hcl-pgdata
API_VOLUME=hcl-apidata

# Images (built by packaging/build-bundle.*; loaded offline at install time)
API_IMAGE=hcl-learning-hub-api:1.0.0
WEB_IMAGE=hcl-learning-hub-web:1.0.0
DB_IMAGE=docker.io/library/postgres:16-alpine

# Database
DB_NAME=hclhub
DB_USER=hcluser

# Networking
HTTP_PORT=30080
API_PORT=4000
DB_PORT=5432

# Local admin fallback account (password is generated at install time
# unless ADMIN_PASSWORD is supplied to the installer)
ADMIN_USERNAME=admin

# Minimum host requirements enforced by the pre-flight check
MIN_CPU_CORES=2
MIN_RAM_MB=3800
MIN_DISK_GB=20
