# ============================================================
# HCL Software Learning Hub — Source Deployment Configuration
#
# Written by install.sh into the install directory and read by
# start.sh / stop.sh / sync.sh. Safe to edit; re-run start.sh after.
#
# Plain KEY=VALUE only (no spaces, no substitution) so it can be
# sourced by any POSIX shell.
# ============================================================

APP_NAME=hcl-learning-hub

# Public hostname used for the browser URL, CORS and the TLS certificate.
SERVER_FQDN=localhost

# Ports
UI_PORT=5173
API_PORT=4000

# PostgreSQL (local instance created by install.sh)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=hclhub
DB_USER=hcluser
DB_CONTAINER_NAME=hcl-postgres
DB_CONTAINER_ENGINE=

# Git origin used by sync.sh
GIT_REPO=https://github.com/raghavendra-bhaskar/Hcl-learning-hub.git
GIT_BRANCH=main
